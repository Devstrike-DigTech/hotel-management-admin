# Backend API origin (the client appends /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Product identity -- the product name is not final, never hard-code it
NEXT_PUBLIC_APP_NAME=HotelOS
NEXT_PUBLIC_APP_DOMAIN=hotelos.ng
NEXT_PUBLIC_SUPPORT_EMAIL=support@hotelos.ng
# Customer-facing site (marketplace + hotel microsites)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
